# =====================================================================
# LALINK — Docker Compose Environment Template
# =====================================================================
# คัดลอกไฟล์นี้ไปเป็น .env แล้วกรอกค่าตามที่ต้องการ:
#   cp .env.docker.example .env
# จากนั้นรัน: docker compose up -d --build
# =====================================================================

# --- Docker ---
CONTAINER_PREFIX=              # e.g. lalink
APP_PORT=3000

# --- App & Auth ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=                   # REQUIRED! ใช้คำสั่ง: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_COOKIE_NAME=lalink_session

# --- Database (REQUIRED) ---
DATABASE_URL=                  # e.g. postgresql://user:pass@host:5432/db?schema=public

# --- LINE Integration (จำเป็นสำหรับ LIFF / แจ้งเตือน) ---
NEXT_PUBLIC_LIFF_ID=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- S3-Compatible Object Storage (MinIO / R2 / AWS S3) ---
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=lalink-attachments
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Seed (ครั้งแรกหลัง deploy เท่านั้น ตั้ง RUN_SEED=true) ---
RUN_SEED=false
SEED_SUPERADMIN_EMAIL=superadmin@platform.com
SEED_SUPERADMIN_PASSWORD=Admin@123456
SEED_SUPERADMIN_NAME=Platform Super Admin

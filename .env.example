# =====================================================================
# LALINK - ระบบลางานออนไลน์ Multi-Tenant SaaS ผ่าน LINE LIFF
# Environment Variables Example Configuration
# =====================================================================

# ---------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL)
# ---------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lalink_saas?schema=public"

# ---------------------------------------------------------------------
# 2. Application & Authentication Security
# ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="your-super-secret-auth-key-at-least-32-chars-change-in-prod"
SESSION_COOKIE_NAME="lalink_session"
NODE_ENV="development"

# ---------------------------------------------------------------------
# 3. LINE Integration (LIFF & Messaging API)
# ---------------------------------------------------------------------
LINE_CHANNEL_ID="your-line-login-channel-id"
LINE_CHANNEL_SECRET="your-line-login-channel-secret"
LINE_CHANNEL_ACCESS_TOKEN="your-line-messaging-api-channel-access-token"
NEXT_PUBLIC_LIFF_ID="your-liff-app-id"

# ---------------------------------------------------------------------
# 4. S3-Compatible Object Storage (MinIO / Cloudflare R2 / AWS S3)
# ---------------------------------------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="lalink-attachments"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"
